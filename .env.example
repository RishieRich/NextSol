# Next Solutions Website configuration.
# Next.js reads env files from the app root, so copy this to ui/frontend/.env.local and fill in.
# Never commit .env files. Every variable the site reads appears here, with a comment and no value.

# Public origin of the site, used for canonical URLs, the sitemap, robots.txt and search data.
# Baked in at build time. Defaults to https://nxtsolutions.in when unset.
NEXT_PUBLIC_SITE_URL=
